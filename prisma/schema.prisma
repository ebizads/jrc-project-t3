generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [uid])

  @@index([name])
}

model Account {
  userId        String    @unique
  type          String
  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?
  password      String
  username      String    @unique
  id            Int       @id @default(autoincrement())
  oldPassword   String[]
  reset_token   String?
  reset_until   DateTime?
  user          User      @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  type         String
  user         User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model User {
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  uid           String    @id @default(cuid())
  id            Int       @default(autoincrement())
  accounts      Account?
  posts         Post[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Generator {
  id                Int                 @id @default(autoincrement())
  generatorName     String?             @unique
  createdAt         DateTime            @default(now())
  deleted           Boolean             @default(false)
  deletedAt         DateTime?
  updatedAt         DateTime?           @updatedAt
  runningTime       Int?
  StatusLogs        StatusLogs[]
  GeneratorStatuses GeneratorStatuses[]
}

model StatusLogs {
  id          Int       @id @default(autoincrement())
  status_type String?
  status_msg  String?
  status      String?
  createdAt   DateTime  @default(now())
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  generatorId Int
  generator   Generator @relation(fields: [generatorId], references: [id])
}

model GeneratorStatuses {
  id             Int       @id @default(autoincrement())
  status_name    String?
  current_status String?
  generatorId    Int
  generator      Generator @relation(fields: [generatorId], references: [id])
}
