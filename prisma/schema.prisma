generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [uid])

  @@index([name])
}

model Account {
  userId        String   @unique
  type          String
  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?
  password      String
  oldPassword   String[]
  username      String   @unique
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
}

model User {
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  uid           String       @id @default(cuid())
  id            Int          @default(autoincrement())
  accounts      Account?
  posts         Post[]
  sessions      Session[]
  StatusLogs    StatusLogs[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StatusLogs {
  id          Int       @id @default(autoincrement())
  status_type String?
  status_msg  String?
  status      String?
  createdAt   DateTime  @default(now())
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  uid         String?
  user        User?     @relation(fields: [uid], references: [uid], onDelete: Cascade)
}
